{
  "name": "browser-ai-copilot",
  "version": "1.0.0",
  "description": "Production-grade Browser AI Copilot Chrome Extension with ReAct agent loop",
  "private": true,
  "workspaces": [
    "apps/extension",
    "apps/backend"
  ],
  "scripts": {
    "install:all": "npm install",
    "build": "npm run build --workspace=apps/extension && npm run build --workspace=apps/backend",
    "dev": "concurrently npm:dev:backend npm:dev:extension",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:extension": "npm run dev --workspace=apps/extension",
    "test": "npm run test --workspace=apps/backend && npm run test --workspace=apps/extension",
    "test:unit": "vitest run tests/unit",
    "test:integration": "npm run test --workspace=apps/backend",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.js",
    "lint": "eslint apps/ --ext .js,.ts",
    "format": "prettier --write \"apps/**/*.{js,ts,json,md}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jsdom": "^29.1.0",
    "prettier": "^3.1.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}