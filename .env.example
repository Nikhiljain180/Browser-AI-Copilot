# ============================================
# Browser AI Copilot - Environment Configuration
# ============================================
# Copy this to .env and configure your values
# API keys MUST stay server-side only!

# ============================================
# LLM Provider Configuration
# ============================================

# LLM Provider (options: openai, anthropic)
LLM_PROVIDER=openai

# Model to use with the provider
# OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229
LLM_MODEL=gpt-4

# ============================================
# LLM API Keys (Server-side only!)
# ============================================

# OpenAI API key - Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API key - Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google API key (reserved for future use)
GOOGLE_API_KEY=your-google-api-key-here

# ============================================
# Backend Server Configuration
# ============================================

# Proxy server host
PROXY_HOST=127.0.0.1

# Proxy server port (Express listens here)
PROXY_PORT=3000

# Node environment
NODE_ENV=development

# ============================================
# Agent & Perception Configuration
# ============================================

# Maximum page context tokens sent to LLM
# Larger = more page context, higher token usage cost
# Recommended: 2000-4000 tokens
# Token estimate: 1 token ≈ 4 characters
MAX_PAGE_CONTEXT_TOKENS=3000

# Alternative: Maximum characters of page context
# Used if token limit not specified
MAX_PAGE_CONTEXT_CHARS=12000

# Maximum ReAct loop iterations
# Prevents infinite loops in multi-step tasks
# Recommended: 8-15 iterations
MAX_REACT_ITERATIONS=10

# ============================================
# Timeout Configuration (milliseconds)
# ============================================

# Timeout for LLM API calls
# Recommended: 30000-60000 (30-60 seconds)
LLM_TIMEOUT_MS=30000

# Timeout for tool execution (click, fill, extract)
# Recommended: 20000-30000 (20-30 seconds)
TOOL_TIMEOUT_MS=30000

# ============================================
# Conversation & Context Management
# ============================================

# Maximum conversation history messages to keep
# Older messages are summarized into context
MAX_CONVERSATION_HISTORY=10

# ============================================
# Feature Flags
# ============================================

# Enable debug logging output
ENABLE_DEBUG_MODE=true

# Use mock LLM responses (for testing without API)
ENABLE_MOCK_RESPONSES=false

# Enable token budget enforcement
ENABLE_TOKEN_BUDGET=true

# Enable DOMPurify sanitization
ENABLE_SANITIZATION=true

# ============================================
# Optional: Monitoring & Analytics
# ============================================

# Sentry error tracking (optional)
SENTRY_DSN=

# PostHog analytics (optional)
POSTHOG_API_KEY=

# ============================================
# Important Security Notes
# ============================================
#
# 1. NEVER commit .env to git (use .gitignore)
# 2. API keys stay server-side ONLY
# 3. Page context never persists on backend
# 4. All user data is client-side
# 5. Backend is stateless (no storage)
#
