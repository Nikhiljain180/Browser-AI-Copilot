{
  "manifest_version": 3,
  "name": "Browser AI Copilot",
  "version": "1.0.0",
  "description": "Production-grade AI Agent for autonomous browser interactions with human-in-the-loop safety gates (least-privilege mode)",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "Browser AI Copilot"
  },
  "side_panel": {
    "default_path": "public/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "icons": {
    "16": "public/icon16.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png",
    "19": "public/icon19.png",
    "32": "public/icon32.png",
    "38": "public/icon38.png"
  }
}

