{
  "manifest_version": 3,
  "name": "Browser AI Copilot",
  "version": "1.0.0",
  "description": "Production-grade AI Agent for autonomous browser interactions with human-in-the-loop safety gates",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "Browser AI Copilot"
  },
  "side_panel": {
    "default_path": "public/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts"
  },
  "content_scripts": [
  {
    "matches": ["<all_urls>"],
    "js": [
      "src/content/core/utils.ts",
      "src/content/core/sanitizer.ts",
      "src/content/core/registry.ts",
      "src/content/core/selector.ts",
      "src/content/core/token-budget.ts",
      "src/content/observers/navigation.ts",
      "src/content/tools/read_page.ts",
      "src/content/tools/click_element.ts",
      "src/content/tools/fill_input.ts",
      "src/content/tools/extract_data.ts",
      "src/content/tools/draft_reply.ts",
      "src/content/tools/summarize_page.ts",
      "src/content/tools/reset_form.ts",
      "src/content/content-script.ts"
    ],
    "run_at": "document_idle"
   }
  ],
  "icons": {
    "16": "public/icon16.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png",
    "19": "public/icon19.png",
    "32": "public/icon32.png",
    "38": "public/icon38.png"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}